# Copie para .env e ajuste
DEBUG=True
SECRET_KEY=troque-esta-chave-em-producao
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (padrao para desenvolvimento)
DATABASE_URL=sqlite:///db.sqlite3
# MariaDB/MySQL externo (producao)
# DATABASE_URL=mysql://usuario:senha@servidor-mariadb:3306/siga

# E-mail Microsoft 365 via OAuth2/Graph. Para SMTP, troque o backend por
# django.core.mail.backends.smtp.EmailBackend e configure EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=apps.notificacoes.backends.MicrosoftGraphEmailBackend
EMAIL_HOST=smtp.mcm.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=siga@mcm.com.br
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SIGA MCM <mcm.tech@mcmtocantins.com>
MICROSOFT_CLIENT_ID=2abbfe39-378c-4cd6-901e-18f45cdf3112
MICROSOFT_TENANT_ID=1ec02aee-85c4-42c9-9681-84e57c2bb571
MICROSOFT_CLIENT_SECRET=cole-aqui-o-segredo-do-aplicativo
MICROSOFT_SENDER_EMAIL=mcm.tech@mcmtocantins.com

# Copias fixas da regua de notificacoes
SIGA_EMAIL_CONSULTORIA=stxambiental@gmail.com
SIGA_EMAIL_GESTAO=ambiental@mcm.com.br
SIGA_EMAIL_DIRETORIA=diretoria@mcm.com.br

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
