[Unit]
Description=SIGA - aplicacao Django
After=network.target mysql.service redis-server.service
Wants=mysql.service redis-server.service

[Service]
Type=notify
User=siga
Group=www-data
WorkingDirectory=/opt/siga
EnvironmentFile=/etc/siga/siga.env
RuntimeDirectory=siga
RuntimeDirectoryMode=0755
ExecStart=/opt/siga/.venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/siga/gunicorn.sock --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
KillSignal=SIGQUIT
TimeoutStopSec=30
Restart=on-failure
PrivateTmp=true

[Install]
WantedBy=multi-user.target
