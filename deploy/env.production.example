# Copie para /etc/siga/siga.env na VPS e substitua todos os valores TROCAR.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=TROCAR_POR_UMA_CHAVE_LONGA_E_ALEATORIA
DEBUG=False
ALLOWED_HOSTS=portalmcm.mcmtocantins.com.br,www.portalmcm.mcmtocantins.com.br
CSRF_TRUSTED_ORIGINS=https://portalmcm.mcmtocantins.com.br,https://www.portalmcm.mcmtocantins.com.br
FORCE_SCRIPT_NAME=/ambiental
STATIC_URL=/ambiental/static/
CSRF_COOKIE_NAME=siga_csrftoken
SESSION_COOKIE_NAME=siga_sessionid
CSRF_COOKIE_PATH=/ambiental/
SESSION_COOKIE_PATH=/ambiental/

DATABASE_URL=mysql://siga:TROCAR_SENHA_MARIADB@HOST_MARIADB:3306/siga
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

STATIC_ROOT=/var/www/siga/staticfiles
MEDIA_ROOT=/var/lib/siga/media

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=TROCAR_SERVIDOR_SMTP
EMAIL_PORT=587
EMAIL_HOST_USER=TROCAR_USUARIO_SMTP
EMAIL_HOST_PASSWORD=TROCAR_SENHA_SMTP
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SIGA MCM <siga@seudominio.com.br>

SIGA_EMAIL_CONSULTORIA=stxambiental@gmail.com
SIGA_EMAIL_GESTAO=ambiental@mcm.com.br
SIGA_EMAIL_DIRETORIA=diretoria@mcm.com.br

# Aumente para 31536000 somente depois de validar definitivamente o HTTPS.
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
